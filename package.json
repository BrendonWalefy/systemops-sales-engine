{
  "name": "systemops-sales-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-migrate": "tsx scripts/migrate.ts && next build",
    "vercel:build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx scripts/check-drizzle-meta.ts",
    "verify": "npm run db:check && npm run lint && npm run typecheck && npm test",
    "verify:agenda": "vitest run src/__tests__/SlotEngine.test.ts src/__tests__/BookingDoubleBooking.test.ts src/__tests__/SlotDayPreference.test.ts src/__tests__/ClinicTimezone.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/migrate.ts",
    "seed": "dotenv -e .env.local -- tsx scripts/seed-ximendes.ts",
    "seed:demo": "dotenv -e .env.local -- tsx scripts/seed-demo.ts",
    "demo:roteiro": "dotenv -e .env.local -- tsx scripts/demo-roteiro.ts",
    "eval:intent": "dotenv -e .env.local -- tsx scripts/eval-intent.ts",
    "replay:export": "dotenv -e .env.local -- tsx scripts/export-sanitized-replay-corpus.ts",
    "replay:review": "tsx scripts/render-replay-review.ts",
    "replay:keys": "tsx scripts/generate-replay-approval-keypair.ts",
    "replay:approve": "tsx scripts/approve-replay-dataset.ts",
    "replay:run": "tsx scripts/run-approved-replay-dataset.ts",
    "replay:calendar": "dotenv -e .env.local -- tsx scripts/capture-replay-calendar-snapshot.ts",
    "replay:sandbox": "tsx scripts/manage-replay-sandbox.ts",
    "performance:summary": "tsx scripts/summarize-performance-logs.ts",
    "create-clinic": "dotenv -e .env.local -- tsx scripts/create-clinic.ts",
    "dev:workers": "dotenv -e .env.local -- ./scripts/dev-workers.sh",
    "db:backfill-schedule": "dotenv -e .env.local -- tsx scripts/backfill-business-schedule.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@fal-ai/client": "^1.10.1",
    "@neondatabase/serverless": "^1.1.0",
    "@schedule-x/calendar": "^4.6.0",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/events-service": "^4.6.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/resize": "^3.7.3",
    "@schedule-x/scroll-controller": "^4.6.0",
    "@schedule-x/theme-default": "^4.6.0",
    "@sentry/nextjs": "^10.68.0",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "^16.2.12",
    "openai": "^6.39.0",
    "postgres": "^3.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "19.1.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "pg": "^8.23.0",
    "react-test-renderer": "19.2.6",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
