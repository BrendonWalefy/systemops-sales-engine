{
  "buildCommand": "npm run vercel:build",
  "crons": [
    {
      "path": "/api/cron/message-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sender-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/stale-conversations",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/deposit-expiry-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/follow-up-dispatcher",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/appointment-reminder",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/metrics-aggregate",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/calendar-watch-renew",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/recovery-campaign",
      "schedule": "0 12 * * 1-6"
    },
    {
      "path": "/api/cron/recovery-campaign-evening",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/cron/conversation-analytics",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/operational-alert-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/conversation-insights",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/lead-outcome-classifier",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/appointment-reminder-staff",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/media-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/resume-expired-takeovers",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/post-appointment-followup",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/stuck-conversation-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/channel-health-alert",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/tts-cleanup",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/decision-trace-cleanup",
      "schedule": "30 4 * * *"
    }
  ]
}
