eracional&lt;/b&gt;&lt;br&gt;Alertas internos ao WhatsApp do responsável ainda usam um caminho operacional separado. Respostas e automações destinadas ao lead usam a outbox durável." style="shape=note;html=1;whiteSpace=wrap;strokeWidth=1;strokeColor=#CBD5E1;fillColor=#FFFDF5;size=18;verticalAlign=top;align=left;spacing=10;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1605" y="800" width="200" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="systemops-target" name="05 • Evolução e escala"><mxGraphModel dx="1920" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-now-sec" value="HOJE • SIMPLES E DURÁVEL" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#2563EB;fillColor=#F8FBFF;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontColor=#172B4D;fontStyle=1;fontSize=14;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="435" height="885" as="geometry"/></mxCell><mxCell id="p5-gates-sec" value="GATES • MEDIR ANTES DE MIGRAR" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#EA580C;fillColor=#FFFBF7;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontColor=#172B4D;fontStyle=1;fontSize=14;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="515" y="125" width="430" height="885" as="geometry"/></mxCell><mxCell id="p5-target-sec" value="ALVO INCREMENTAL • NÃO É BIG BANG" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#94A3B8;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontColor=#172B4D;fontStyle=1;fontSize=14;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="980" y="125" width="895" height="885" as="geometry"/></mxCell><mxCell id="e10" value="Drizzle" st