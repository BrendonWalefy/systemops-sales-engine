olor:#0F172A;&quot;&gt;Outbox compartilhada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;outbound_messages(category=campaign) + jobs(message.send)&lt;/span&gt;&lt;/div&gt;" style="shape=process;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="530" y="665" width="350" height="100" as="geometry"/></mxCell><mxCell id="p4-safety" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;CHANNEL SAFETY&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Safety Gate no sender&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;revalida opt-out • destino • quiet hours • caps • warmup • obsolescência&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#DC2626;fillColor=#FEF2F2;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="665" width="380" height="100" as="geometry"/></mxCell><mxCell id="p4-deliver" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;DELIVERY&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Z-API → WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;texto aprovado; modo ensaio redireciona até 5 mensagens&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#16A34A;fillColor=#ECFDF3;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1460" y="665" width="330" height="100" as="geometry"/></mxCell><mxCell id="p4-feedback" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;LOOP&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Feedback da jornada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;sent → replied → converted • resposta volta pelo webhook e atualiza lead/conversa&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0F766E;fillColor=#E6FFFB;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="530" y="825" width="830" height="85" as="geometry"/></mxCell><mxCell id="p4-cron" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SCHEDULER&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Vercel Cron&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;rotinas protegidas por CRON_SECRET&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#EA580C;fillColor=#FFF3E8;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1080" width="240" height="150" as="geometry"/></mxCell><mxCell id="p4-follow" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;10h UTC diário&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Follow-up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;lead some após interesse&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="1025" width="300" height="55" as="geometry"/></mxCell><mxCell id="p4-recovery" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;12h + 21h&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Recovery automática&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;leads frios/cancelados/expirados&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="1095" width="300" height="55" as="geometry"/></mxCell><mxCell id="p4-reminder" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;13h UTC&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Lembrete D-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;20–32h antes; idempotente&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#16A34A;fillColor=#ECFDF3;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="1165" width="300" height="55" as="geometry"/></mxCell><mxCell id="p4-post" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;a cada 30 min&lt;/span&gt;&lt;br&