try relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-conv" target="p5-data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="targets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-auto" target="p5-data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-title" value="&lt;div style=&quot;text-align:left;line-height:1.2;&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:1px;color:#2563EB;font-weight:700;&quot;&gt;EVOLUÇÃO ORIENTADA POR MÉTRICAS&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:25px;color:#172B4D;&quot;&gt;05 — Arquitetura alvo e gatilhos de escala&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;SQS antes de microsserviços • Strangler por bounded context • Kafka somente para streaming e replay em escala&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1840" height="75" as="geometry"/></mxCell><mxCell id="p5-vercel" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;MONOLITH&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Next.js / Vercel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;UI • APIs • crons&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#111827;fillColor=#EEF2F7;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="200" width="335" height="90" as="geometry"/></mxCell><mxCell id="p5-pg" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SYSTEM OF RECORD&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Neon PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;dados + config + inbox + jobs + outbox&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="95" y="350" width="335" height="135" as="geometry"/></mxCell><mxCell id="p5-workers" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;CRON&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Workers lógicos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;message.process • message.send • automations&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#EA580C;fillColor=#FFF3E8;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="545" width="335" height="105" as="geometry"/></mxCell><mxCell id="p5-patterns" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;KEEP&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Garantias existentes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;atomicidade • dedupe • leases • retry • DLQ&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="710" width="335" height="105" as="geometry"/></mxCell><mxCell id="p5-now-note" value="&lt;b&gt;Decisão atual&lt;/b&gt;&lt;br&gt;Sem Kafka e sem microsserviços. Um deploy e um banco reduzem custo, latência de coordenação e risco operacional." style="shape=note;html=1;whiteSpace=wrap;strokeWidth=1;strokeColor=#CBD5E1;fillColor=#FFFDF5;size=18;verticalAlign=top;align=left;spacing=10;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="95" y="855" width="335" height="115" as="geometry"/></mxCell><mxCell id="p5-queue-gate" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SQS&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Gate 1 • Fila&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;p95 &gt; 30s • backlog &gt; 5min • contenção no OLTP&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#CA8A04;fillColor=#FEFCE8;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="565" y="205" width="330" height="115" as="geometry"/></mxCell><mxCell id="p5-worker-gate" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;WORKERS&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Gate 2 • Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;escala, SLO ou deploy independente&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#EA580C;fillColor=#FFF3E8;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="565" y="370" width="330" height="115" as="geometry"/></mxCell><mxCell id="p5-service-gate" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;STRANGLER&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Gate 3 • Serviço&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;owner + dados + contrato + rollback claros&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="565" y="535" width="330" height="115" as="geometry"/></mxCell><mxCell id="p5-kafka-gate" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;KAFKA&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Gate 4 • Streaming&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;100+ eventos/s • replay • 3–5 consumers&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#DC2626;fillColor=#FEF2F2;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="565" y="700" width="330" height="115" as="geometry"/></mxCell><mxCell id="p5-gate-note" value="&lt;b&gt;Clientes não são o único sinal&lt;/b&gt;&lt;br&gt;Volume, lag, contenção, blast radius e ownership decidem. Dez tenants intensivos podem exigir evolução antes de cem tenants leves." style="shape=note;html=1;whiteSpace=wrap;strokeWidth=1;strokeColor=#CBD5E1;fillColor=#FFFDF5;size=18;verticalAlign=top;align=left;spacing=10;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="565" y="855" width="330" height="115" as="geometry"/></mxCell><mxCell id="p5-api" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;EDGE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Vercel Web / API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;auth • tenant • comandos&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#111827;fillColor=#EEF2F7;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="190" width="230" height="85" as="geometry"/></mxCell><mxCell id="p5-process" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;QUEUE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;SQS FIFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;message.process + DLQ&lt;/span&gt;&lt;/div&gt;" style="shape=process;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="210" height="95" as="geometry"/></mxCell><mxCell id="p5-conv" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SERVICE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Conversation Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;core + LLM + booking&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="180" width="220" height="95" as="geometry"/></mxCell><mxCell id="p5-outbox" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;POSTGRES&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Transactional Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;estado + evento confirmado&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1030" y="350" width="230" height="95" as="geometry"/></mxCell><mxCell id="p5-send" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;QUEUE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;SQS FIFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;message.send + DLQ&lt;/span&gt;&lt;/div&gt;" style="shape=process;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="350" width="210" height="95" as="geometry"/></mxCell><mxCell id="p5-delivery" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SERVICE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Delivery Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;safety + canal + TTS&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#16A34A;fillColor=#ECFDF3;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="350" width="220" height="95" as="geometry"/></mxCell><mxCell id="p5-autoq" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;QUEUE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;SQS Standard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;automations + DLQ&lt;/span&gt;&lt;/div&gt;" style="shape=process;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="535" width="230" height="95" as="geometry"/></mxCell><mxCell id="p5-auto" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;SERVICE&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Campaign Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;follow-up + campanhas&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#EA580C;fillColor=#FFF3E8;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="535" width="210" height="95" as="geometry"/></mxCell><mxCell id="p5-events" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;FAN-OUT&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;EventBridge / SNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;eventos confirmados&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#7C3AED;fillColor=#F3E8FF;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="535" width="220" height="95" as="geometry"/></mxCell><mxCell id="p5-data" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;DATA&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Neon PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;system of record compartilhado no primeiro estágio&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#2563EB;fillColor=#EAF2FF;verticalAlign=middle;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1030" y="720" width="500" height="105" as="geometry"/></mxCell><mxCell id="p5-consumers" value="&lt;div style=&quot;line-height:1.25;text-align:center;&quot;&gt;&lt;span style=&quot;display:inline-block;padding:2px 6px;border-radius:10px;background:#E2E8F0;color:#334155;font-size:9px;font-weight:700;&quot;&gt;ASYNC&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#0F172A;&quot;&gt;Consumers independentes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;métricas • alertas • integrações&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;strokeWidth=1.5;strokeColor=#0F766E;fillColor=#E6FFFB;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="720" width="220" height="105" as="geometry"/></mxCell><mxCell id="p5-target-note" value="&lt;b&gt;Invariantes&lt;/b&gt;&lt;br&gt;Tenant antes de dados • inbox/outbox transacional • consumer idempotente • FIFO por conversa • DLQ auditada • LLM não decide ação final." style="shape=note;html=1;whiteSpace=wrap;strokeWidth=1;strokeColor=#CBD5E1;fillColor=#FFFDF5;size=18;verticalAlign=top;align=left;spacing=10;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1030" y="870" width="790" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
