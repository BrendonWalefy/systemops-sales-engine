    <mxCell id="road1_body" value="Remover directTreatmentMention como classificador forçado.&#xa;IntentClassifier SEMPRE é chamado. Usar classification.slotPreference.identifiedTreatment&#xa;para enriquecer o dispatch — não para forçar a intenção.&#xa;Resultado: lead que diz &quot;quero agendar implante amanhã&quot; vê os slots." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8e6;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1202" width="1160" height="75" as="geometry" />
    </mxCell>

    <mxCell id="road2" value="🟡 FASE 2 — Mover constantes hardcoded para clinics (migration)" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1290" width="1160" height="32" as="geometry" />
    </mxCell>

    <mxCell id="road2_body" value="Adicionar campos em clinics com valores padrão idênticos ao atual (zero breaking change para Ximendes):&#xa;rateLimitPerHour=60, unclearThreshold=3, staleConversationHours=4, slotOfferTtlMinutes=15,&#xa;maxSlotsToOffer=5, mediaTakeoverTtlHours=null. Orchestrator lê do banco em vez da constante." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1327" width="1160" height="75" as="geometry" />
    </mxCell>

    <mxCell id="road3" value="🟡 FASE 3 — Criar campos estruturados em treatments" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1415" width="1160" height="32" as="geometry" />
    </mxCell>

    <mxCell id="road3_body" value="Adicionar: treatments.triggerTemplate (text nullable), treatments.keywordMatchEnabled (boolean, default true),&#xa;treatments.aliases[] (text array), treatments.isAesthetic (boolean).&#xa;Migrar TRIGGER FORMAT de playbook_versions.notes para treatments.triggerTemplate.&#xa;Remover AESTHETIC_TREATMENT_KEYWORDS do código." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1452" width="1160" height="75" as="geometry" />
    </mxCell>

    <mxCell id="road4" value="🟠 FASE 4 — Mover anti-repetição do LLM para o sistema" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="1380" y="1540" width="1160" height="32" as="geometry" />
    </mxCell>

    <mxCell id="road4_body" value="Orchestrator rastreia campos já comunicados por conversa (ex: endereço, preço, parcelamento).&#xa;Antes de chamar ResponseComposer, filtra o actionResult passando APENAS informação nova.&#xa;Remove a instrução de anti-repetição do system prompt do LLM.&#xa;Resultado: playbook &quot;SEMPRE mencione X&quot; funciona de forma previsível." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="1">
