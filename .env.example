DATABASE_URL="postgres://user:password@localhost:5432/systemops"
SESSION_SECRET="change-me-in-production"
NEXT_PUBLIC_APP_URL="https://app.systemops.com.br"
E2E_WEBHOOK_URL="https://app.systemops.com.br/api/whatsapp/zapi"

# Provisionamento automático de instância Z-API no onboarding do owner.
# ZAPI_PARTNER_TOKEN: autoriza SÓ os endpoints de parceiro (criar/assinar/
# cancelar instância). Hoje recebe o Client-Token da conta (autoriza criar até
# 25 instâncias via API); ao virar parceiro oficial, troca pelo token
# definitivo de integrador — sem mudar código.
ZAPI_PARTNER_TOKEN=""
# ZAPI_ACCOUNT_CLIENT_TOKEN: o Client-Token da conta usado no header
# Client-Token de toda chamada por-instância (send, status, qr-code...).
# Hoje é o MESMO valor de ZAPI_PARTNER_TOKEN (só existe uma credencial ainda),
# mas são conceitualmente distintas: ao virar parceiro oficial, só
# ZAPI_PARTNER_TOKEN muda — esta permanece a mesma. Se não definida, o código
# usa ZAPI_PARTNER_TOKEN como fallback (comportamento de hoje).
ZAPI_ACCOUNT_CLIENT_TOKEN=""
# Opcional: exige ?secret= na URL do webhook configurado nas instâncias.
ZAPI_WEBHOOK_SECRET=""

# Auth - Owner (acesso ao /owner panel)
OWNER_EMAIL="seu-email@dominio.com"
OWNER_PASSWORD="senha-owner"

# Auth - Clinic admins
# Usuários de clínica vivem em clinic_members.password_hash, criados pelo owner
# ou por scripts de onboarding. Não use senha global compartilhada.

# Google Calendar (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# AI
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY é exigida quando o modelo configurado começa com "claude-".
ANTHROPIC_API_KEY=""
# Overrides opcionais. Vazios preservam os defaults definidos em código.
SETUP_STUDY_MODEL=""
OPENAI_CLASSIFIER_MODEL=""
OPENAI_COMPOSER_MODEL=""
OPENAI_COMPOSER_MODEL_PREMIUM=""
OPENAI_V2_UNDERSTANDING_MODEL=""

# Cycle I V2 shadow. Chave exclusiva de pseudonimização (mínimo 32 chars);
# não reutilize chave de sessão, webhook ou export de replay.
CONVERSATION_V2_COMPARISON_HMAC_KEY=""
CONVERSATION_V2_SHADOW_MAX_TURNS="10"
CONVERSATION_V2_SHADOW_DEADLINE_MS="20000"
ADVISOR_MODEL=""
FAL_KEY=""  # Necessário quando ttsVoice = "dora" (Kokoro PT-BR via fal.ai)

# Storage (Vercel Blob — para áudio TTS gerado pela IA)
BLOB_READ_WRITE_TOKEN=""

# Operação
CRON_SECRET=""
TOGGLE_SECRET=""
SIMULATE_API_KEY=""

# Integrações compartilhadas
RESEND_API_KEY=""
VERCEL_SPEND_WEBHOOK_SECRET=""
VERCEL_TEAM_ID=""

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# Observabilidade (Sentry — error tracking)
# Opcional: vazio usa armazenamento sanitizado no banco por 30 dias.
# Use "off" para desligar ou "structured_log" para logs efêmeros. Nenhum modo
# inclui corpo, prompt, resposta, telefone, nome ou URL.
DECISION_TRACE_MODE=""
# Export local e read-only do corpus de replay. Nunca configure no browser.
# Allowlist por slug, separada por vírgulas. A chave deve ter 32+ caracteres e
# serve somente para pseudonimizar IDs de origem via HMAC.
REPLAY_EXPORT_ALLOWED_CLINICS=""
REPLAY_EXPORT_HASH_KEY=""
# O DSN é uma chave pública (client key) e pode ir para o front. Cadastre-o em
# TODOS os ambientes da Vercel (Production/Preview) e nos workers.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="systemops-yp"
SENTRY_PROJECT="javascript-nextjs"
# Secret — só no build da Vercel, para upload de source maps.
# Gere em Sentry > Settings > Auth Tokens (scopes: project:releases, org:read).
SENTRY_AUTH_TOKEN=""
# Opcional: force o envio em dev local para testar (server + client).
# SENTRY_FORCE_ENABLE="1"
# NEXT_PUBLIC_SENTRY_FORCE_ENABLE="1"

# --- Testes de integração contra banco (opt-in explícito) ---------------------
# NUNCA colocar estas variáveis em .env.local: .env.local aponta para o banco
# compartilhado de produção. Elas vivem em .env.test.local, lido só por
# `npm run test:db`. Sem elas, os testes que escrevem em banco são pulados;
# com DATABASE_URL mas sem elas, a suíte falha alto em vez de escrever calada.
# TEST_DATABASE_HOST precisa ser igual ao host da DATABASE_URL acima e diferente
# de PRODUCTION_DATABASE_HOST — apontar teste para produção exige mentir duas vezes.
TEST_DATABASE_HOST="ep-your-test-branch-pooler.sa-east-1.aws.neon.tech"
PRODUCTION_DATABASE_HOST="ep-your-production-branch-pooler.sa-east-1.aws.neon.tech"

# Deny-list de identidade de tenant para o corpus (nome de prédio, bairro,
# estação). Separado por vírgula. Sem ela a extração mantém marcos que
# identificam a clínica mesmo com o endereço já redigido.
CORPUS_REDACT_PLACES=""
