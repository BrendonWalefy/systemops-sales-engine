DATABASE_URL="postgres://user:password@localhost:5432/systemops"
SESSION_SECRET="change-me-in-production"

# Auth - Owner (acesso ao /owner panel)
OWNER_EMAIL="seu-email@dominio.com"
OWNER_PASSWORD="senha-owner"

# Auth - Clinic admins
# Usuários de clínica vivem em clinic_members.password_hash, criados pelo owner
# ou por scripts de onboarding. Não use senha global compartilhada.

# Google Calendar (service account)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# WhatsApp por clínica
# Cadastre credenciais em clinics.* pelo owner/onboarding.
WHATSAPP_VERIFY_TOKEN=""

# AI
OPENAI_API_KEY=""

# QA / Testes — instâncias isoladas, nunca usar valores de produção
QA_GOOGLE_CALENDAR_ID=""     # Calendar separado para sandbox de testes (omniQA)
SIMULATE_API_KEY=""          # Chave de API para omniQA chamar /api/playbook/simulate
ZAPI_TEST_INSTANCE_ID=""     # Instância Z-API de testes (número WhatsApp separado)
ZAPI_TEST_TOKEN=""
ZAPI_TEST_CLIENT_TOKEN=""
ZAPI_TEST_PHONE=""           # Número do WhatsApp de testes
