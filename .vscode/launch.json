{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next: Dev (with inspector)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "preLaunchTask": "start-workers",
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to Node (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229
    }
  ]
}
